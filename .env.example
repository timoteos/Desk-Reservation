# Copy to .env for local development. Never commit the real .env.
#
# Locally, DATABASE_URL can be left unset entirely: node-postgres then connects
# over the Unix socket as your macOS user, which is how this project has run so
# far. It is listed here because every hosted database needs it.

# ---------------------------------------------------------------- database ---
# Local (either form works):
#   DATABASE_URL=postgresql://localhost/desk_reservation
#
# Hosted — note sslmode, which managed providers require. pg 8.x reads it
# straight from the URL, so no code change is needed:
#   DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://localhost/desk_reservation

# ------------------------------------------------------------------- auth ---
# Signs admin session tokens. The server refuses to start signing without it
# rather than falling back to a default, so this is required everywhere.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-locally-and-use-a-real-random-value-in-any-deployment

# ------------------------------------------------------------------ server ---
# Local port. Hosted platforms inject PORT themselves and the server prefers
# SERVER_PORT, then PORT, then 5000.
SERVER_PORT=5001

# Browser origins allowed to call this API, comma-separated. Leave unset for
# local development and CORS stays open, which is what create-react-app on
# localhost:3000 needs. Set it for anything reachable:
#   CORS_ORIGINS=https://timoteos.github.io
# CORS_ORIGINS=

# ------------------------------------------------------------------ client ---
# Read by create-react-app at BUILD time, not at runtime — it is inlined into
# the bundle. It therefore has to be set wherever `npm run build` happens, not
# on the API host. Unset, the frontend calls http://localhost:5001.
REACT_APP_API_URL=http://localhost:5001

# -------------------------------------------------------------------- seed ---
# Only for `npm run seed:demo`. The demo seed refuses to run without it rather
# than using the password written into server/seed.js, which is in the
# repository and would make any reader an administrator.
# DEMO_ADMIN_PASSWORD=

# The seed truncates every table and refuses to point at a non-local host unless
# this is set. Supply it deliberately, once, on the command line — never in a
# file that stays in your shell environment.
# ALLOW_REMOTE_SEED=1
