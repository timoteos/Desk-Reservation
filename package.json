{
  "name": "desk_reservation",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.23.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "seed:demo": "node server/seed.js --demo",
    "build": "react-scripts build",
    "predeploy": "PUBLIC_URL=/Desk-Reservation npm run build",
    "deploy": "gh-pages -d build",
    "test": "react-scripts test",
    "test:server": "jest --config jest.server.config.js",
    "test:all": "react-scripts test --watchAll=false && jest --config jest.server.config.js",
    "eject": "react-scripts eject",
    "lint": "eslint src server --ext .js,.jsx",
    "lint:fix": "eslint src server --ext .js,.jsx --fix"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.5.2",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  }
}
