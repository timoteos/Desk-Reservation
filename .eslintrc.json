{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "react-app",
    "react-app/jest"
  ],
  "plugins": ["import"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "import/no-duplicates": "error"
  },
  "overrides": [
    {
      "files": ["server/**/*.js"],
      "env": {
        "browser": false,
        "node": true,
        "es2021": true
      },
      "plugins": ["n", "import"],
      "extends": ["plugin:n/recommended"],
      "rules": {
        "no-console": "off",
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
        "n/no-process-exit": "off",
        "n/no-unpublished-require": "off"
      }
    }
  ]
}
